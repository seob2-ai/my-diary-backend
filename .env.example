# ?섍꼍 ?ㅼ젙 ?뚯씪 ?덉떆
# ???뚯씪??蹂듭궗?섏뿬 .env ?뚯씪??留뚮뱶?몄슂: cp .env.example .env

# ?섍꼍
# development | staging | production
ENVIRONMENT=development
DEBUG=true

# ?곗씠?곕쿋?댁뒪
# SQLite: sqlite:///./diary.db
# PostgreSQL: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///./diary.db

# CORS ?ㅼ젙
# 媛쒕컻 ?섍꼍: ?щ윭 異쒖쿂瑜?肄ㅻ쭏濡?援щ텇
# ?꾨줈?뺤뀡 ?섍꼍: ?ㅼ젣 ?꾨찓?몃쭔 ?덉슜
# 紐⑤뱺 異쒖쿂 ?덉슜 (媛쒕컻??: *
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# 濡쒓퉭
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG
LOG_DIR=logs

# ?쒕쾭
HOST=0.0.0.0
PORT=8000
